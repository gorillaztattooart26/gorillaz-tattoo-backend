# Supabase — get these from your project dashboard:
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Active payment provider (lib/payments/config.ts). Only "paymongo" is a
# real, working integration today — "xendit" is a foundation-only stub
# (services/providers/xendit.ts) pending business approval on the Xendit
# account; every method on it throws. Leave unset or "paymongo" to keep the
# app on PayMongo; nothing else needs to change.
PAYMENT_PROVIDER=paymongo

# PayMongo — get these from https://dashboard.paymongo.com/developers
PAYMONGO_SECRET_KEY=
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=
# From Developers -> Webhooks -> [endpoint] -> Signing secret (only exists
# once a webhook endpoint is registered against a deployed URL)
PAYMONGO_WEBHOOK_SECRET=

# Xendit — reserved for the future migration, not used by any code path
# yet. Not required for the app to run; only needed once PAYMENT_PROVIDER
# is switched to "xendit" and services/providers/xendit.ts is actually
# implemented.
XENDIT_SECRET_KEY=
XENDIT_PUBLIC_KEY=
XENDIT_WEBHOOK_TOKEN=

# Supabase service role key — Dashboard -> Settings -> API -> service_role
# secret. Server-only, bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Signs the private booking-portal session cookie (lib/booking-session.ts).
# Server-only. Falls back to SUPABASE_SERVICE_ROLE_KEY if unset — set this
# explicitly in production so booking sessions aren't tied to a key that
# also grants full database access.
BOOKING_SESSION_SECRET=

# Resend — get this from https://resend.com/api-keys. Server-only.
RESEND_API_KEY=
# onboarding@resend.dev until a domain is verified in Resend.
RESEND_FROM_EMAIL=
# Where staff notifications are sent (new inquiry, payment received,
# booking cancelled/rescheduled).
STAFF_NOTIFICATION_EMAIL=

# Analytics (optional, independent of each other) — see lib/analytics.ts.
# Leave both blank to keep analytics off; nothing else changes when unset.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Only needed if self-hosting Plausible instead of using plausible.io.
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=
